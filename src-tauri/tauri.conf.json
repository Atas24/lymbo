{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lymbo",
  "version": "3.0.0",
  "identifier": "com.lymbo.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lymbo",
        "width": 1200,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM4Mzc2NTM0RkNCQjlDOTIKUldTU25MdjhOR1UzeUpFdkRUTG15KzNZWFg5bEo3QmFLR2g3VnFsUENiMTRZYWcyeHFDL3JGUWIK",
      "endpoints": [
        "https://github.com/Atas24/lymbo/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
